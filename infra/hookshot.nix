{ config, lib, pkgs, ... }:
# NOT in the effective config: this module is exported as
# self.nixosModules.hookshot but commented out of maliketh's module list in
# flake.nix. It is kept because the wiring here is correct and worth reusing.
#
# What remains to do before re-enabling is written up in todo.md under
# "Finish setting up matrix-hookshot" — the short version is that the bridge
# starts but has never been registered with tuwunel or joined to a room, so
# enabling it only produces a failing unit.
let
  domain = "free-rat.dev";
  registrationFile = "/var/lib/matrix-hookshot/registration.yml";
  hookshotUser = config.services.matrix-tuwunel.user;
  hookshotGroup = config.services.matrix-tuwunel.group;
in
{
  services.matrix-hookshot = {
    enable = true;

    registrationFile = registrationFile;

    settings = {
      passFile = "/var/lib/matrix-hookshot/passkey.pem";

      bridge = {
        domain = domain;
        url = "http://localhost:6167";
        mediaUrl = "https://matrix.${domain}";
        port = 9993;
        bindAddress = "127.0.0.1";
      };

      logging = {
        level = "info";
      };

      listeners = [
        {
          port = 9000;
          bindAddress = "127.0.0.1";
          resources = [ "webhooks" ];
        }
        {
          port = 9001;
          bindAddress = "127.0.0.1";
          resources = [ "metrics" "provisioning" ];
        }
      ];

      generic = {
        enabled = true;
        outbound = true;
        urlPrefix = "https://hooks.${domain}/webhook/";
        allowJsTransformationFunctions = false;
        waitForComplete = false;
        userIdPrefix = "_webhooks_";
      };

      bot = {
        displayname = "Hookshot";
      };

      permissions = [
        {
          actor = domain;
          services = [
            {
              service = "*";
              level = "admin";
            }
          ];
        }
      ];
    };

    serviceDependencies = [ "tuwunel.service" ];
  };

  services.matrix-tuwunel.settings.global.appservice_dir = "/var/lib/matrix-hookshot/appservices";

  systemd.services.tuwunel = {
    after = [ "matrix-hookshot-registration.service" ];
    wants = [ "matrix-hookshot-registration.service" ];
  };

  systemd.tmpfiles.rules = [
    "d /var/lib/matrix-hookshot 0750 ${hookshotUser} ${hookshotGroup} - -"
    "d /var/lib/matrix-hookshot/appservices 0750 ${hookshotUser} ${hookshotGroup} - -"
  ];

  systemd.services.matrix-hookshot-registration = {
    description = "Matrix Hookshot registration bootstrap";
    before = [ "matrix-hookshot.service" ];
    requiredBy = [ "matrix-hookshot.service" ];
    path = [ pkgs.openssl ];
    # Runs as root, deliberately. It has to be able to take ownership of state
    # left behind by a previous configuration: this module used to run as its
    # own `matrix-hookshot` user, and after that user was removed the existing
    # registration.yml and passkey.pem were left as 0600 with an orphaned
    # numeric uid, which tuwunel cannot read and cannot chown. Running this as
    # tuwunel meant hookshot failed with EACCES and nothing could repair it.
    serviceConfig = {
      Type = "oneshot";
      RemainAfterExit = true;
    };
    script = ''
      if [ ! -f ${registrationFile} ]; then
        AS_TOKEN="$(openssl rand -hex 32)"
        HS_TOKEN="$(openssl rand -hex 32)"
        cat > ${registrationFile} << 'YAMLEOF'
      id: matrix-hookshot
      as_token: AS_TOKEN_PLACEHOLDER
      hs_token: HS_TOKEN_PLACEHOLDER
      namespaces:
        rooms: []
        users:
          - regex: "@_webhooks_.*:${domain}"
            exclusive: true
          - regex: "@hookshot.*:${domain}"
            exclusive: true
      sender_localpart: hookshot
      url: "http://localhost:9993"
      rate_limited: false
      receive_ephemeral: true
      YAMLEOF
        ${pkgs.gnused}/bin/sed -i \
          "s/AS_TOKEN_PLACEHOLDER/$AS_TOKEN/" \
          ${registrationFile}
        ${pkgs.gnused}/bin/sed -i \
          "s/HS_TOKEN_PLACEHOLDER/$HS_TOKEN/" \
          ${registrationFile}
      fi

      if [ ! -L /var/lib/matrix-hookshot/appservices/hookshot.yml ]; then
        ln -s ${registrationFile} /var/lib/matrix-hookshot/appservices/hookshot.yml
      fi

      # Unconditionally, not just when the file was created above. The whole
      # point is to repair state whose ownership is already wrong; doing this
      # inside the `if` is what let the EACCES failure persist across rebuilds.
      # passkey.pem is generated by the module's own preStart and needs the same
      # treatment, or the failure just moves one file along.
      chown -R ${hookshotUser}:${hookshotGroup} /var/lib/matrix-hookshot
      chmod 600 ${registrationFile}
      if [ -f /var/lib/matrix-hookshot/passkey.pem ]; then
        chmod 600 /var/lib/matrix-hookshot/passkey.pem
      fi
    '';
  };

  systemd.services.matrix-hookshot.serviceConfig = {
    User = hookshotUser;
    Group = hookshotGroup;
    ReadWritePaths = [ "/var/lib/matrix-hookshot" ];
    RuntimeDirectory = "matrix-hookshot";
    RuntimeDirectoryMode = "0700";
    ProtectSystem = "strict";
    ProtectHome = true;
    PrivateTmp = true;
    NoNewPrivileges = true;
  };

  services.caddy.virtualHosts."hooks.${domain}" = {
    extraConfig = ''
      reverse_proxy localhost:9000
    '';
  };
}
